{
  "search_engine": "google",
  "headless_mode": false,
  "delay_between_searches": 5,
  "max_links_per_search": 10,
  "output_file": "results.json",
  "remove_tracking_params": true,
  "use_gemini_classifier": true,
  "combine_keywords": false,
  "captcha_wait_seconds": 300,
  "page_load_timeout": 20,
  "expand_keywords": true,
  "max_expansion_rounds": 2,
  "max_new_keywords_per_round": 10,
  "min_keyword_site_count": 2,
  "min_expansion_confidence": 0.7,
  "expansion_log_file": "keyword_expansion.json"
}
